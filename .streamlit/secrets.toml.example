# Optional. SFD Exercise Studio asks each user for their own AI key. Set a key
# here only if you deploy the app and want a "Use the key set for this app"
# button (the key is tested, never shown).
#
# Copy this file to .streamlit/secrets.toml (never commit that file).

llm_provider = "gemini"            # "anthropic", "openai" or "gemini"
gemini_api_key = "AIza..."
# anthropic_api_key = "sk-ant-..."
# openai_api_key = "sk-..."
# llm_model = "gemini-3.5-flash-lite"
