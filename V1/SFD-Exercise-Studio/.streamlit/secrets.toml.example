# ---------------------------------------------------------------------------
# OPTIONAL — this app does NOT need a secrets file.
#
# The API key is entered by the user in the app's sidebar and kept only in
# the browser session. If you (the person hosting the app) want the sidebar
# key field to come PRE-FILLED, copy this file to .streamlit/secrets.toml
# and add a key below. Otherwise, delete or ignore this file.
# ---------------------------------------------------------------------------

# anthropic_api_key = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"
# openai_api_key    = "sk-xxxxxxxxxxxxxxxxxxxxxxxx"
